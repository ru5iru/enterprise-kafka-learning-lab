# Repository defaults; no parent editor settings should leak into this project.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Prefer paragraphs/lists over trailing-space Markdown hard breaks in new work.
[*.md]
trim_trailing_whitespace = true

[*.java]
indent_size = 4

[*.{xml,pom}]
indent_size = 2

# Preserve the inherited CSV working-copy layout and significant cell spaces.
[*.csv]
end_of_line = crlf
trim_trailing_whitespace = false

# Windows command scripts are the explicit line-ending exception.
[*.{bat,cmd}]
end_of_line = crlf
