# Ignore rules are hygiene, not secret detection: tracked files remain tracked.
# Review staged diffs; never use force-add to publish credentials.
# OS, editors and local env
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.swp
.env
.env.*
!.env.example
!.env.*.example
# Example names are allowed only for sanitized, non-secret placeholders.

# Java / Maven / Gradle
target/
build/
.gradle/
*.class
*.log

# Python local helpers
__pycache__/
*.py[cod]
.venv/

# Credentials and PKI secrets
# PEM/ASC may also contain public material; deliberately exclude until reviewed.
# Add a narrow exception only for an approved, non-secret fixture in a later task.
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.kdb
*.asc
*.secret
secrets/
**/private/

# Kubernetes / Terraform local state
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
*.tfplan
kubeconfig

# Runtime and generated data
*.pid
*.tmp
*.bak
coverage/
reports/generated/

# Local lab state and database exports (SQL migrations remain visible)
.local/
/runtime/
*.dump
*.sql.gz
